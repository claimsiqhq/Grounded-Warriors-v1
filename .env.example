# ----------------------------------------------------------------------
# Grounded Warriors - environment variables
# Copy this file to `.env` for local development, or set these values in
# the Render dashboard (or your hosting provider's secrets UI) for prod.
# ----------------------------------------------------------------------

# Node environment ("development" locally, "production" on Render)
NODE_ENV=development

# Port the Express server listens on. Render injects PORT automatically
# (10000 by default); locally we use 5000.
PORT=5000

# Public URL of the deployed site (no trailing slash). Used to build
# Stripe checkout return URLs, Stripe webhook URLs, and password-reset
# links in transactional emails.
# Local:  http://localhost:5000
# Render: https://your-service-name.onrender.com  (or your custom domain)
APP_URL=http://localhost:5000

# ---- PostgreSQL ------------------------------------------------------
# Full Postgres connection string. On Render this is provided
# automatically by the managed database via render.yaml.
DATABASE_URL=postgres://user:password@host:5432/grounded_warriors

# ---- Clerk authentication --------------------------------------------
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx
VITE_CLERK_PROXY_URL=/api/__clerk

# Comma-separated list of email addresses that should be auto-promoted
# to admin role on register/login. Admins can designate per-retreat
# staff and enter every retreat container.
# Example: STAFF_EMAILS=john@example.com,bcoones@gmail.com
STAFF_EMAILS=

# Comma-separated recipients for Brown Courage Coaching applications.
# Falls back to STAFF_EMAILS if unset.
COACHING_INBOX_EMAILS=

# ---- Stripe ----------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Signing secret from the environment-specific Stripe webhook endpoint.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ---- Supabase private media -----------------------------------------
# Used server-side only for the private retreat photo bucket. Never
# expose the service-role key through a VITE_ variable.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# ---- SendGrid (transactional email) ----------------------------------
SENDGRID_API_KEY=SG.xxx
# Verified sender address in your SendGrid account.
SENDGRID_FROM_EMAIL=hello@groundedwarriors.com

# ---- Flodesk (newsletter / email marketing) --------------------------
# API key from Flodesk: Workspace > Integrations > API.
FLODESK_API_KEY=
# Optional: comma-separated Flodesk segment IDs that new subscribers
# from the website should be added to (e.g. "seg_abc123,seg_def456").
FLODESK_SEGMENT_IDS=
# Optional: User-Agent string Flodesk requires for API calls.
FLODESK_USER_AGENT=Grounded Warriors (groundedwarriors.com)
