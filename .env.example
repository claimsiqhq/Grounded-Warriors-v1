# ----------------------------------------------------------------------
# Grounded Warriors - environment variables
# Copy this file to `.env` for local development, or set these values in
# the Render dashboard (or your hosting provider's secrets UI) for prod.
# ----------------------------------------------------------------------

# Node environment ("development" locally, "production" on Render)
NODE_ENV=development

# Port the Express server listens on. Render injects PORT automatically
# (10000 by default); locally we use 5000.
PORT=5000

# Public URL of the deployed site (no trailing slash). Used to build
# Stripe checkout return URLs, Stripe webhook URLs, and password-reset
# links in transactional emails.
# Local:  http://localhost:5000
# Render: https://your-service-name.onrender.com  (or your custom domain)
APP_URL=http://localhost:5000

# ---- PostgreSQL ------------------------------------------------------
# Full Postgres connection string. On Render this is provided
# automatically by the managed database via render.yaml.
DATABASE_URL=postgres://user:password@host:5432/grounded_warriors

# ---- Sessions / Auth -------------------------------------------------
# Long random string used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=replace-me-with-a-long-random-string

# ---- Stripe ----------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Optional: signing secret from your Stripe webhook endpoint.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ---- SendGrid (transactional email) ----------------------------------
SENDGRID_API_KEY=SG.xxx
# Verified sender address in your SendGrid account.
SENDGRID_FROM_EMAIL=hello@groundedwarriors.com
